{
  "name": "pi-search-broker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local Exa + Tavily account-aware key rotation gateway (search broker) for pi-web-access, with a pi extension",
  "keywords": ["pi-package", "pi-extension", "exa", "tavily", "pi-web-access"],
  "engines": { "node": ">=20.3" },
  "files": ["src/", "extension/", "README.md"],
  "pi": {
    "extensions": ["./extension/index.js"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "init": "node src/cli.mjs init",
    "status": "node src/cli.mjs status",
    "doctor": "node src/cli.mjs doctor",
    "reconcile": "node src/cli.mjs reconcile",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
